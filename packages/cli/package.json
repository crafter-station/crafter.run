{
  "name": "@crafter/cli",
  "version": "0.0.0",
  "type": "module",
  "description": "Ship projects to the Crafter Station community directory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/crafter.run.git",
    "directory": "packages/cli"
  },
  "homepage": "https://crafter.run/ships",
  "bugs": "https://github.com/crafter-station/crafter.run/issues",
  "bin": {
    "crafter": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --noEmit && bun build src/index.ts --outfile dist/index.js --target bun --minify",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@crafter/contracts": "workspace:*",
    "@types/bun": "^1.3.0",
    "typescript": "5.7.3"
  }
}
